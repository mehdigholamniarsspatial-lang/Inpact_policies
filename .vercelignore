# Files the deployed site never reads. Keeping them out of the upload keeps the
# Vercel Python function under its 500 MB bundle limit.

# Local tooling and editor settings
.claude/
.git/
**/__pycache__/

# Offline audit reports and the scripts that write them
audit/

# Raw GeoTIFFs: only used locally to regenerate data/RasterPrerendered/
data/Raster/
# Raw EDGAR GeoTIFFs: packed into data/EDGAR/ by scripts/build_edgar_grids.py
geotiff/
# Raw PARIS inversion GeoTIFFs + notebook: packed into data/InverseModel/ by scripts/build_inverse_grids.py
InversionModel/
scripts/
