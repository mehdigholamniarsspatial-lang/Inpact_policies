    "DIOX":   { "name": "Dioxins and furans",                      "formula": "PCDD/F", "group": "Persistent organic pollutants", "unit": null },
    "HCB":    { "name": "Hexachlorobenzene",                       "formula": "HCB",    "group": "Persistent organic pollutants", "unit": null },
