    "CH4":    { "name": "Methane",                                 "formula": "CH₄",    "group": "Greenhouse gases",              "unit": null },
    "N2O":    { "name": "Nitrous oxide",                           "formula": "N₂O",    "group": "Greenhouse gases",              "unit": null },
    "HFCs":   { "name": "Hydrofluorocarbons",                      "formula": "HFCs",   "group": "Fluorinated gases",             "unit": null },
