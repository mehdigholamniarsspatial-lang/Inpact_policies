{
  "_about": [
    "Display names, groups and units for the MapEIre emission overlays in data/Raster and data/RasterPrerendered.",
    "Files are named <Year>_<Sector>_p<Pollutant>; 'sectors' is keyed by the <Sector> part and 'pollutants' by the part after 'p'.",
    "unit: a key of 'units', or null when the MapEIre report does not state it. Set it once the unit is confirmed and the map shows it everywhere.",
    "name_confirmed: false marks a pollutant whose code expansion is not stated in the report.",
    "Unit evidence: EPA Research Report 'MapEIre' (Nielsen et al., 2019), Fig. 3 legends give national totals in kt per 1 km cell for PM2.5, CO2, NOx and NH3; the CO2, NOx and NH3 maxima match these files exactly."
  ],
  "source": {
    "dataset": "MapEIre national gridded emissions",
    "credit": "EPA Ireland / Aarhus University",
    "resolution": "1 km × 1 km",
    "projection": "TM65 Irish Grid (EPSG:29902)",
    "coverage": "Irish Exclusive Economic Zone"
  },
  "units": {
    "kt": {
      "short": "kt / km²",
      "long": "kilotonnes per 1 km × 1 km grid cell"
    }
  },
  "groups": [
    "Greenhouse gases",
    "Fluorinated gases",
    "Acidifying gases",
    "Ozone precursors",
    "Particulate matter",
    "Heavy metals",
    "Persistent organic pollutants"
  ],
  "sectors": {
    "A_PublicPower":         { "name": "Public power",                     "code": "GNFR A", "order": 1 },
    "B_Industry":            { "name": "Industry",                         "code": "GNFR B", "order": 2 },
    "C_OtherStationaryComb": { "name": "Other stationary combustion",      "code": "GNFR C", "order": 3 },
    "D_Fugitive":            { "name": "Fugitive emissions",               "code": "GNFR D", "order": 4 },
    "E_Solvents":            { "name": "Solvent use",                      "code": "GNFR E", "order": 5 },
    "F_RoadTransport":       { "name": "Road transport",                   "code": "GNFR F", "order": 6 },
    "G_Shipping":            { "name": "Shipping",                         "code": "GNFR G", "order": 7 },
    "H_Aviation":            { "name": "Aviation",                         "code": "GNFR H", "order": 8 },
    "I_Offroad":             { "name": "Off-road mobile machinery",        "code": "GNFR I", "order": 9 },
    "J_Waste":               { "name": "Waste",                            "code": "GNFR J", "order": 10 },
    "K_AgriLivestock":       { "name": "Agriculture – livestock",          "code": "GNFR K", "order": 11 },
    "L_AgriOther":           { "name": "Agriculture – other",              "code": "GNFR L", "order": 12 },
    "O_AviCruise":           { "name": "Aviation – cruise",                "code": "GNFR O", "order": 13 },
    "P_IntShipping":         { "name": "International shipping",           "code": "GNFR P", "order": 14 },
    "q_LULUCF":              { "name": "Land use, land-use change and forestry (LULUCF)", "code": "LULUCF", "order": 15 },
    "NFRTotal":              { "name": "National total – air pollutants",  "code": "NFR total", "order": 20 },
    "CRFTotal":              { "name": "National total – greenhouse gases", "code": "CRF total", "order": 21 },
    "CRF_NationalTotal":     { "name": "National total – greenhouse gases", "code": "CRF national total", "order": 22 }
  },
  "pollutants": {
