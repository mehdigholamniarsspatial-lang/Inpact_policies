    "SF6":    { "name": "Sulphur hexafluoride",                    "formula": "SF₆",    "group": "Fluorinated gases",             "unit": null },
    "NF3":    { "name": "Nitrogen trifluoride",                    "formula": "NF₃",    "group": "Fluorinated gases",             "unit": null },
    "NOx":    { "name": "Nitrogen oxides",                         "formula": "NOₓ",    "group": "Acidifying gases",              "unit": "kt" },
